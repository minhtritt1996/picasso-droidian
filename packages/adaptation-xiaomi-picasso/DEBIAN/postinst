#!/bin/bash
set -e

# Update module dependencies
depmod -a 4.19.113-lineage-picasso+ || depmod -a || true

# Set permissions
chmod +x /usr/local/bin/phosh-wrapper /usr/local/bin/panel-on 2>/dev/null || true

# Reload udev rules
udevadm control --reload-rules || true
udevadm trigger || true

# Enable systemd services
systemctl daemon-reload
systemctl enable backlight-boot.service || true

# Mask conflict services
systemctl mask droidian-fpd.service picasso-audio.service picasso-wifi.service 2>/dev/null || true

echo "=== adaptation-xiaomi-picasso installed successfully ==="
exit 0
