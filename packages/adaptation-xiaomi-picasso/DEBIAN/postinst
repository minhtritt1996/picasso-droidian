#!/bin/bash
set -e

# Update module dependencies
CURRENT_KVER=$(uname -r)
if [ -n "$CURRENT_KVER" ] && [ ! -d "/lib/modules/$CURRENT_KVER" ]; then
    ln -snf /lib/modules/4.19.113-lineage-picasso+ "/lib/modules/$CURRENT_KVER" 2>/dev/null || true
fi
depmod -a 4.19.113-lineage-picasso+ 2>/dev/null || true
depmod -a 2>/dev/null || true

# Set permissions
chmod +x /usr/local/bin/* 2>/dev/null || true
[ -f /usr/bin/droidian-camera.bin ] && chmod 755 /usr/bin/droidian-camera.bin || true

# Android init refuses to parse group/other-writable vendor rc files
# ("Skipping insecure file"), so keep them strictly 644 root:root.
chmod 644 /usr/lib/droid-vendor-overlay/etc/init/*.rc 2>/dev/null || true

# Compile glib schemas
if command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true
fi

# Reload udev rules
udevadm control --reload-rules || true
udevadm trigger || true

# Disable UFS runtime PM, clock gating and clock scaling immediately
for node in clkgate_enable clkscale_enable auto_hibern8 rpm_lvl; do
    f="/sys/bus/platform/devices/1d84000.ufshc/$node"
    [ -w "$f" ] && echo 0 > "$f" 2>/dev/null || true
done
if [ -w /sys/bus/platform/devices/1d84000.ufshc/power/control ]; then
    echo on > /sys/bus/platform/devices/1d84000.ufshc/power/control 2>/dev/null || true
fi


# Update dconf database for system-wide background settings
if command -v dconf >/dev/null 2>&1; then
    dconf update || true
fi

# Disable kernel coredump safely to prevent translation fault oops
mkdir -p /etc/sysctl.d
cat << 'EOF' > /etc/sysctl.d/99-disable-coredump.conf
kernel.core_pattern = core
fs.suid_dumpable = 0
EOF
sysctl -p /etc/sysctl.d/99-disable-coredump.conf 2>/dev/null || true

# Enable systemd services
systemctl daemon-reload
systemctl enable backlight-boot.service || true
systemctl enable k30-display-power.service k30-powerkey.service k30-wifi.service bluebinder.service k30-pmic-pet.service picasso-audio.service k30-waydroid-binder.service || true
/usr/local/bin/k30-waydroid-binder-init 2>/dev/null || true

# Configure libdroid_fix for direct brightness control
if ! grep -qs "/usr/local/lib/libdroid_fix.so" /etc/ld.so.preload 2>/dev/null; then
    echo "/usr/local/lib/libdroid_fix.so" >> /etc/ld.so.preload
fi
chmod 0666 /sys/class/backlight/*/brightness 2>/dev/null || true
chmod 0666 /sys/class/leds/flashlight/brightness 2>/dev/null || true

# Configure status bar safezone for Xiaomi Redmi K30 5G dual punch-hole
for udir in /etc/skel /home/droidian; do
    if [ -d "$udir" ]; then
        mkdir -p "$udir/.config/gtk-3.0"
        cat << 'EOF' > "$udir/.config/gtk-3.0/gtk.css"
/* Xiaomi Redmi K30 5G (picasso) Status Bar & Notch Safezone */
phosh-top-panel {
  min-height: 54px;
}

phosh-top-panel-bg {
  min-height: 54px;
}

#top-bar-bin {
  min-height: 54px;
}

#top-bar {
  min-height: 54px;
}

#top-bar > widget,
#top-bar > label,
#top-bar > box,
#box_network,
#lbl_clock,
#box_indicators {
  margin-top: 15px;
  margin-bottom: 7px;
}

#box_network {
  padding-left: 12px;
}

#box_indicators {
  padding-right: 135px;
}
EOF
        if [ "$udir" = "/home/droidian" ]; then
            chown -R droidian:droidian /home/droidian/.config 2>/dev/null || true
        fi
    fi
done

# Configure PulseAudio droid-card with correct Android audio policy XML
if [ -f /etc/pulse/arm_droid_card_custom.pa ]; then
    mv /etc/pulse/arm_droid_card_custom.pa /etc/pulse/arm_droid_card_custom.pa.bak || true
fi
sed -i 's|load-module module-droid-card.*|load-module module-droid-card config=/etc/pulse/audio_policy_configuration.xml rate=48000 voice_virtual_stream=true|' /etc/pulse/default.pa 2>/dev/null || true
sed -i 's|load-module module-bluetooth-policy.*|load-module module-bluetooth-policy auto_switch=1 a2dp_source=false ag=false|' /etc/pulse/default.pa 2>/dev/null || true

# Mask conflict / problematic services
systemctl mask droidian-fpd.service picasso-wifi.service mobile-power-saver.service 2>/dev/null || true

# Fix usb0 netmask (/8 -> /24) on the running system; at boot it is
# re-asserted by the usb-tethering.service drop-in. Capped (10s) so a
# missing usb0 never stalls dpkg; the script itself always exits 0.
timeout 10 /usr/local/bin/k30-usb0-netfix.sh 2>/dev/null || true

# Apply display anti-flicker and 120Hz lock immediately
/usr/local/bin/k30-display-power.sh 2>/dev/null || true

# Fix gnome-control-center sound panel template bug (missing id="headphone_group")
if [ -f /usr/lib/droidian/device/cc_sound_fixed.gresource ] && [ -x /usr/bin/gnome-control-center ]; then
    if ! strings /usr/bin/gnome-control-center | grep -q 'id="headphone_group"'; then
        cp -a /usr/bin/gnome-control-center /usr/bin/gnome-control-center.orig 2>/dev/null || true
        objcopy --update-section .gresource.cc_sound=/usr/lib/droidian/device/cc_sound_fixed.gresource /usr/bin/gnome-control-center 2>/dev/null || true
    fi
fi

echo "=== adaptation-xiaomi-picasso installed successfully ==="
exit 0
