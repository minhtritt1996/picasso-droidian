# Custom ALSA audio routing for Xiaomi Redmi K30 5G (picasso)
load-module module-alsa-sink device=hw:0,0 tsched=0 fragments=4 fragment_size=24000 mmap=0 sink_name=speaker channels=2 rate=48000 sink_properties="device.description='Speaker' device.form_factor='speaker' device.icon_name='audio-speakers'"
load-module module-alsa-source device=hw:0,0 tsched=0 fragments=4 fragment_size=24000 mmap=0 source_name=mic channels=2 rate=48000 source_properties="device.description='Internal Microphone' device.form_factor='internal' device.icon_name='audio-input-microphone'"
set-default-sink speaker
set-default-source mic
