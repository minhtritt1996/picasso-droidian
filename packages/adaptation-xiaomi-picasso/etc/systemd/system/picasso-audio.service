[Unit]
Description=Xiaomi Redmi K30 5G Audio Initialization & SmartPA Daemon
After=adspboot.service sound.target
Wants=sound.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/picasso-audio-init
ExecStart=/usr/local/bin/picasso-audio-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
