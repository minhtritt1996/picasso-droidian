[Unit]
Description=Restore display backlight on boot (save on shutdown, default 50%)
After=phosh.service
DefaultDependencies=no
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/k30-backlight.sh restore
ExecStop=/usr/local/bin/k30-backlight.sh save
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
